{
  "manifest_version": 3,
  "name": "Cleanmarks",
  "version": "0.1.0",
  "description": "A fresh start for your bookmarks. Find broken links and clear the clutter.",
  "permissions": ["bookmarks", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Cleanmarks",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "sidebar_action": {
    "default_panel": "src/sidebar/index.html",
    "default_title": "Cleanmarks",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
